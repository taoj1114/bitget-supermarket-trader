# 复制为 .env 并填入真实密钥, 然后 chmod 600 .env
# Bitget API(v2, 需开启合约交易权限, 建议申请 IP 白名单)
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# LLM(OpenAI 兼容端点, 例如 opencode zen/go: https://opencode.ai/zen/go/v1)
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL_FLASH=deepseek-v4.1-flash

# 实盘确认开关: 只有显式置为 yes 才允许 live 模式启动
LIVE_CONFIRM=no

# Telegram 告警推送(可选, 留空则静默): @BotFather 创建 bot 得 token; chat_id 由 getUpdates 获取
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
